[
 {
  "id": 1,
  "take": "L01_narrator",
  "start": 0.29,
  "end": 3.463,
  "speech_s": 3.07,
  "letters": 47,
  "lps": 15.3,
  "text": "In a happy little house in Sydney lived the Rehman family.",
  "flag": false
 },
 {
  "id": 2,
  "take": "L02_narrator",
  "start": 0.225,
  "end": 4.855,
  "speech_s": 4.08,
  "letters": 39,
  "lps": 9.56,
  "text": "Mum, Dad, big brother Hamd, Aizah, and little Jazaa.",
  "flag": false
 },
 {
  "id": 3,
  "take": "L03_hamd",
  "start": 0.275,
  "end": 4.607,
  "speech_s": 4.05,
  "letters": 53,
  "lps": 13.08,
  "text": "Dad, my friend says the family with the most money wins. Are we rich?",
  "flag": false
 },
 {
  "id": 4,
  "take": "L04_dad",
  "start": 0.0,
  "end": 4.468,
  "speech_s": 4.42,
  "letters": 60,
  "lps": 13.58,
  "text": "Ah, Hamd. We have a treasure bigger than any money. Shall we find it together?",
  "flag": false
 },
 {
  "id": 5,
  "take": "L05_jazaa",
  "start": 0.0,
  "end": 1.721,
  "speech_s": 1.72,
  "letters": 16,
  "lps": 9.3,
  "text": "A treasure hunt! Yes!",
  "flag": false
 },
 {
  "id": 6,
  "take": "L06_narrator",
  "start": 0.216,
  "end": 2.296,
  "speech_s": 1.98,
  "letters": 28,
  "lps": 14.14,
  "text": "Clue number one was in the kitchen.",
  "flag": false
 },
 {
  "id": 7,
  "take": "L07_mum",
  "start": 0.271,
  "end": 6.145,
  "speech_s": 5.59,
  "letters": 65,
  "lps": 11.64,
  "text": "Dad works long days, and I work hard too, so you can have food, school and a warm home.",
  "flag": false
 },
 {
  "id": 8,
  "take": "L08_mum",
  "start": 0.293,
  "end": 3.948,
  "speech_s": 3.21,
  "letters": 47,
  "lps": 14.64,
  "text": "That's why we spend wisely, and buy only what we really need.",
  "flag": false
 },
 {
  "id": 9,
  "take": "L09_aizah",
  "start": 0.245,
  "end": 2.421,
  "speech_s": 1.82,
  "letters": 27,
  "lps": 14.8,
  "text": "And we never waste food, right Mum?",
  "flag": false
 },
 {
  "id": 10,
  "take": "L10_mum",
  "start": 0.199,
  "end": 4.606,
  "speech_s": 3.61,
  "letters": 46,
  "lps": 12.76,
  "text": "Never. Take a little, finish it all, and say Alhamdulillah.",
  "flag": false
 },
 {
  "id": 11,
  "take": "L11_narrator",
  "start": 0.265,
  "end": 4.44,
  "speech_s": 3.87,
  "letters": 60,
  "lps": 15.49,
  "text": "Clue number two was at the front door, with a basket of fruit and warm bread.",
  "flag": false
 },
 {
  "id": 12,
  "take": "L12_dad",
  "start": 0.0,
  "end": 3.503,
  "speech_s": 3.5,
  "letters": 47,
  "lps": 13.42,
  "text": "Uncle Yusuf next door is unwell today. Let's share with him.",
  "flag": false
 },
 {
  "id": 13,
  "take": "L13_jazaa",
  "start": 0.288,
  "end": 3.202,
  "speech_s": 2.55,
  "letters": 46,
  "lps": 18.03,
  "text": "And I'll share my lunch with my friend Mia. She forgot hers!",
  "flag": false
 },
 {
  "id": 14,
  "take": "L14_narrator",
  "start": 0.292,
  "end": 2.799,
  "speech_s": 2.41,
  "letters": 42,
  "lps": 17.44,
  "text": "Clue number three came on the way home from the park.",
  "flag": false
 },
 {
  "id": 15,
  "take": "L15_hamd",
  "start": 0.223,
  "end": 5.199,
  "speech_s": 4.38,
  "letters": 66,
  "lps": 15.06,
  "text": "Some boys wanted me to skip school and be mean to a new kid. I said no, and walked away.",
  "flag": false
 },
 {
  "id": 16,
  "take": "L16_dad",
  "start": 0.0,
  "end": 4.061,
  "speech_s": 4.06,
  "letters": 55,
  "lps": 13.54,
  "text": "I'm proud of you. Good friends make you better. Choose them carefully.",
  "flag": false
 },
 {
  "id": 17,
  "take": "L17_narrator",
  "start": 0.292,
  "end": 2.486,
  "speech_s": 2.09,
  "letters": 29,
  "lps": 13.85,
  "text": "The last clue led to Grandpa's bench.",
  "flag": false
 },
 {
  "id": 18,
  "take": "L18_aizah",
  "start": 0.224,
  "end": 2.986,
  "speech_s": 2.28,
  "letters": 36,
  "lps": 15.78,
  "text": "Salaam, Grandpa! Let me carry your tea for you.",
  "flag": false
 },
 {
  "id": 19,
  "take": "L19_narrator",
  "start": 0.286,
  "end": 2.638,
  "speech_s": 2.25,
  "letters": 33,
  "lps": 14.66,
  "text": "Grandpa smiled the biggest smile of all.",
  "flag": false
 },
 {
  "id": 20,
  "take": "L20_jazaa",
  "start": 0.276,
  "end": 3.457,
  "speech_s": 2.48,
  "letters": 39,
  "lps": 15.7,
  "text": "Dad, we found every clue. But where's the treasure?",
  "flag": false
 },
 {
  "id": 21,
  "take": "L21_dad",
  "start": 0.0,
  "end": 5.756,
  "speech_s": 5.76,
  "letters": 60,
  "lps": 10.42,
  "text": "Look around you. Mum, Grandpa, all of us together. Our family is the treasure.",
  "flag": false
 },
 {
  "id": 22,
  "take": "L22_narrator",
  "start": 0.205,
  "end": 6.736,
  "speech_s": 4.94,
  "letters": 67,
  "lps": 13.55,
  "text": "Spend wisely. Waste nothing. Help others. Choose good friends. Respect your elders.",
  "flag": false
 },
 {
  "id": 23,
  "take": "L23_kids",
  "start": 0.281,
  "end": 2.374,
  "speech_s": 1.99,
  "letters": 26,
  "lps": 13.05,
  "text": "And love your family most of all!",
  "flag": false
 }
]